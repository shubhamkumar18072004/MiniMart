{
  "name": "minimart",
  "version": "1.0.0",
  "description": "MiniMart grocery app API",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "client": "npm start --prefix frontend",
    "server": "npm run dev",
    "dev:full": "concurrently \"npm run server\" \"npm run client\"",
    "build:client": "npm run build --prefix frontend",
    "start:full": "npm run build:client && npm start"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "multer": "^2.1.1",
    "otp-generator": "^4.0.1",
    "razorpay": "^2.9.6",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  }
}
