# Backend base URL (no trailing slash).
# Development: point at your API server.
REACT_APP_API_URL=http://localhost:5000
#
# Production: if the React app is served from the same host as the API, leave unset or empty
# so requests use relative paths (/api/...).
# REACT_APP_API_URL=
#
# Or set an explicit API host, e.g. https://api.yourdomain.com
